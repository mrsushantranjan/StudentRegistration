@model StudentRegistration.Models.Student

@{
    ViewData["Title"] = "Student Profile - " + Model.Name;
    var initials = string.Join("", Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]));

    var badgeClass = Model.Course switch
    {
        "Computer Engineering" => "badge-ce",
        "Information Technology" => "badge-it",
        "Data Science" => "badge-ds",
        _ => "badge-default"
    };

    var courseIcon = Model.Course switch
    {
        "Computer Engineering" => "bi-cpu",
        "Information Technology" => "bi-globe",
        "Data Science" => "bi-pie-chart",
        _ => "bi-mortarboard"
    };
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="profile-card">
            <!-- Gradient Header Banner -->
            <div class="profile-card-header">
                <div class="profile-avatar-large">
                    @initials
                </div>
                <h4 class="fw-bold mb-1 text-white">@Model.Name</h4>
                <div class="d-inline-flex align-items-center gap-1 mt-1">
                    <span class="badge bg-white text-dark shadow-sm px-3 py-1 rounded-pill small fw-semibold">
                        <i class="bi @courseIcon me-1 text-primary"></i> @Model.Course
                    </span>
                </div>
            </div>

            <!-- Details List -->
            <div class="p-3">
                <!-- Row: Student ID -->
                <div class="profile-detail-row">
                    <span class="detail-label">
                        <i class="bi bi-hash text-muted"></i> Student ID
                    </span>
                    <span class="detail-value text-primary">
                        #@Model.Id
                    </span>
                </div>

                <!-- Row: Full Name -->
                <div class="profile-detail-row">
                    <span class="detail-label">
                        <i class="bi bi-person text-muted"></i> Full Name
                    </span>
                    <span class="detail-value">
                        @Model.Name
                    </span>
                </div>

                <!-- Row: Email -->
                <div class="profile-detail-row">
                    <span class="detail-label">
                        <i class="bi bi-envelope text-muted"></i> Email Address
                    </span>
                    <span class="detail-value">
                        <a href="mailto:@Model.Email" class="text-decoration-none text-dark hover-underline">
                            @Model.Email
                        </a>
                    </span>
                </div>

                <!-- Row: Course -->
                <div class="profile-detail-row">
                    <span class="detail-label">
                        <i class="bi bi-mortarboard text-muted"></i> Academic Program
                    </span>
                    <span class="badge-course @badgeClass">
                        <i class="bi @courseIcon"></i>
                        <span>@Model.Course</span>
                    </span>
                </div>

                <!-- Row: Semester -->
                <div class="profile-detail-row">
                    <span class="detail-label">
                        <i class="bi bi-calendar3 text-muted"></i> Current Semester
                    </span>
                    <span class="semester-pill">
                        Semester @Model.Semester of 8
                    </span>
                </div>

                <!-- Row: Enrollment Status -->
                <div class="profile-detail-row">
                    <span class="detail-label">
                        <i class="bi bi-patch-check text-muted"></i> Status
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill small fw-semibold">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Active Enrolled
                    </span>
                </div>
            </div>

            <!-- Card Actions Footer -->
            <div class="p-4 bg-light border-top d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2" id="btnBackToList">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back to Directory</span>
                </a>

                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm" id="btnRegisterAnother">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Register New</span>
                </a>
            </div>
        </div>
    </div>
</div>
