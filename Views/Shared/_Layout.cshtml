<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentPortal</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header class="app-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-glass py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Student" asp-action="Index">
                    <span class="brand-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>
                    <span class="brand-text">
                        <span class="fw-bold text-dark">Student</span><span class="text-primary fw-extrabold">Hub</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto align-items-center gap-2 pt-3 pt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Student" ? "active" : "")" asp-controller="Student" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Students Directory
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3 py-2 rounded-pill shadow-sm d-flex align-items-center gap-2 header-cta-btn" asp-controller="Student" asp-action="Create">
                                <i class="bi bi-person-plus-fill"></i>
                                <span>Register Student</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4 my-2 app-main-content">
        @RenderBody()
    </main>

    <footer class="app-footer py-4 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                <span>&copy; @DateTime.Now.Year StudentHub • Academic Management System</span>
            </div>
            <div class="d-flex align-items-center gap-3 small text-muted">
                <span class="badge bg-light text-secondary border px-2 py-1"><i class="bi bi-code-slash me-1"></i> ASP.NET Core MVC</span>
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted hover-underline">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
