@model StudentRegistration.Models.Student

@{
    ViewData["Title"] = "Register Student";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="form-minimal-card">
            <!-- Form Header -->
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="stat-icon stat-icon-indigo">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Register New Student</h4>
                    <span class="text-muted small">Enter student academic and contact information</span>
                </div>
            </div>

            <form asp-controller="Student" asp-action="Create" method="post" id="registerStudentForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                <!-- Full Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label-modern">
                        <i class="bi bi-person text-primary"></i> Full Name
                    </label>
                    <div class="input-icon-group">
                        <input asp-for="Name" class="form-control" placeholder="e.g. John Doe" id="studentNameInput" autocomplete="name" />
                        <i class="bi bi-person input-icon"></i>
                    </div>
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Email Address -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label-modern">
                        <i class="bi bi-envelope text-primary"></i> Email Address
                    </label>
                    <div class="input-icon-group">
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@university.edu" id="studentEmailInput" autocomplete="email" />
                        <i class="bi bi-envelope input-icon"></i>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Course / Specialization -->
                <div class="mb-3">
                    <label asp-for="Course" class="form-label-modern">
                        <i class="bi bi-mortarboard text-primary"></i> Academic Program
                    </label>
                    <div class="input-icon-group">
                        <select asp-for="Course" class="form-select" id="studentCourseSelect">
                            <option value="">Select a program...</option>
                            <option value="Computer Engineering">Computer Engineering</option>
                            <option value="Information Technology">Information Technology</option>
                            <option value="Data Science">Data Science</option>
                        </select>
                        <i class="bi bi-mortarboard input-icon"></i>
                    </div>
                    <span asp-validation-for="Course" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Semester -->
                <div class="mb-4">
                    <label asp-for="Semester" class="form-label-modern">
                        <i class="bi bi-calendar3 text-primary"></i> Current Semester (1 - 8)
                    </label>
                    <div class="input-icon-group">
                        <input asp-for="Semester" type="number" min="1" max="8" class="form-control" placeholder="e.g. 5" id="studentSemesterInput" />
                        <i class="bi bi-calendar3 input-icon"></i>
                    </div>
                    <span asp-validation-for="Semester" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex align-items-center justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-pill text-muted fw-medium d-inline-flex align-items-center gap-1" id="btnCancel">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>

                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm d-inline-flex align-items-center gap-2" id="btnSubmitStudent">
                        <i class="bi bi-check2-circle"></i>
                        <span>Register Student</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
